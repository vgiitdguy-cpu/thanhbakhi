local function autoSelectFlyGear()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    local foundItem = nil

    local function checkContainer(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                for _, name in ipairs(allowedGears) do
                    if string.lower(item.Name) == string.lower(name) then
                        return item.Name
                    end
                end
            end
        end
        return nil
    end

    foundItem = checkContainer(backpack) or checkContainer(character)

    if foundItem then
        selectedFlyGear = foundItem
        FlyGearBtn.Text = "Fly Gear: " .. foundItem
    else
        selectedFlyGear = nil
        FlyGearBtn.Text = "Fly Gear: None"
    end
end

