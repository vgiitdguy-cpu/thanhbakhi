local function updateFlyGearMenu()
    for _, child in ipairs(FlyScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local foundCount = 0

    local NoneBtn = Instance.new("TextButton")
    NoneBtn.Parent = FlyScroll
    NoneBtn.BackgroundColor3 = Color3.fromRGB(50, 30, 30)
    NoneBtn.Size = UDim2.new(1, -5, 0, 24)
    NoneBtn.Font = Enum.Font.Gotham
    NoneBtn.Text = "[ Tắt Auto Gear ]"
    NoneBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    NoneBtn.TextSize = 11
    Instance.new("UICorner", NoneBtn).CornerRadius = UDim.new(0, 4)
    
    NoneBtn.MouseButton1Click:Connect(function()
        selectedFlyGear = nil
        FlyGearBtn.Text = "Auto use fly gear: None"
        FlyGearFrame.Visible = false
    end)

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    local availableItems = {}

    local function checkItem(item)
        if item:IsA("Tool") then
            for _, name in ipairs(allowedGears) do
                if string.lower(item.Name) == string.lower(name) and not availableItems[item.Name] then
                    availableItems[item.Name] = item.Name
                end
            end
        end
    end

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do checkItem(item) end
    end
    if character then
        for _, item in ipairs(character:GetChildren()) do checkItem(item) end
    end

    for itemName, _ in pairs(availableItems) do
        foundCount = foundCount + 1
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Parent = FlyScroll
        ItemBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        ItemBtn.Size = UDim2.new(1, -5, 0, 24)
        ItemBtn.Font = Enum.Font.Gotham
        ItemBtn.Text = itemName
        ItemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        ItemBtn.TextSize = 11
        Instance.new("UICorner", ItemBtn).CornerRadius = UDim.new(0, 4)

        ItemBtn.MouseButton1Click:Connect(function()
            selectedFlyGear = itemName
            FlyGearBtn.Text = "Auto use: " .. itemName
            FlyGearFrame.Visible = false
        end)
    end

    FlyScroll.CanvasSize = UDim2.new(0, 0, 0, (foundCount + 1) * 28)
end

FlyGearBtn.MouseButton1Click:Connect(function()
