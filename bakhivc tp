local function equipSelectedGear()
    if not selectedFlyGear then return end
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if not char or not backpack then return end
    
    local equippedTool = char:FindFirstChild(selectedFlyGear)
    if not equippedTool then
        local toolInBackpack = backpack:FindFirstChild(selectedFlyGear)
        if toolInBackpack then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:EquipTool(toolInBackpack)
            end
        end
    end
end

local function executeTeleport()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if selectedFlyGear then
        equipSelectedGear()
        task.wait(0.02)
    end

    if Set1Position then
        hrp.CFrame = Set1Position
    end
    
    task.wait(0.123)
    
    if Set2Position then
        hrp.CFrame = Set2Position
    end
end

TopTpButton.MouseButton1Click:Connect(executeTeleport)

