local isChocolaHidden = false

local function setChocolaVisibility(hidden)
    local targetCore = CoreGui
    local targetPlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    
    local function processGui(gui)
        if not gui then return end
        for _, child in ipairs(gui:GetChildren()) do
            if child:IsA("ScreenGui") and child.Name ~= "ZenkidTPGui" then
                local lowerName = string.lower(child.Name)
                if string.find(lowerName, "chocola") or string.find(lowerName, "aim") or string.find(lowerName, "hub") then
                    child.Enabled = not hidden
                else
                    for _, sub in ipairs(child:GetDescendants()) do
                        if sub:IsA("TextLabel") or sub:IsA("TextButton") then
                            local txt = string.lower(sub.Text)
                            if string.find(txt, "chocola") then
                                child.Enabled = not hidden
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    processGui(targetCore)
    processGui(targetPlayerGui)
end

